{
  "code_scanning": {
    "posture": {
      "workflows": {
        "require_permissions_block": "fail",
        "forbid_write_all": "fail",
        "require_pinned_actions": "warn",
        "allow_tag_pin": ["blackoutsecure/bos-automation-hub"]
      },
      "branches": {
        "main": {
          "require_conversation_resolution": true,
          "severity": "fail"
        },
        "dev": {}
      },
      "dependencies": {
        "require_declared_license": "warn",
        "forbid_non_osi_license": "warn",
        "forbid_denied_license": "warn",
        "check_compatibility": "warn",
        "allow": [],
        "deny": [
          "AGPL-3.0",
          "AGPL-3.0-only",
          "AGPL-3.0-or-later",
          "SSPL-1.0",
          "BUSL-1.1",
          "Elastic-2.0"
        ],
        "catalogue_max_age_days": 400
      },
      "source_licenses": {
        "require_spdx_headers": "skip",
        "min_header_coverage": 80,
        "forbid_foreign_license": "warn",
        "require_consistent_copyright": "warn",
        "check_compatibility": "warn",
        "allow": [],
        "project_license": "Apache-2.0",
        "max_files": 5000
      }
    },
    "remediation": {
      "enable_ai_findings_summary": false
    }
  }
}
